<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101018">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="SAFAYAT"
            android:textColor="#A855F7"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Music Player"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Your music, your world."
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/scanButton"
            android:text="SCAN MY MUSIC"
            android:textColor="#FFFFFF"
            android:backgroundTint="#9333EA"
            android:layout_marginTop="25dp"
            android:layout_width="match_parent"
            android:layout_height="55dp"/>

        <TextView
            android:text="YOUR LIBRARY"
            android:textColor="#A855F7"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/statusText"
            android:text="Your songs will appear here."
            android:textColor="#AAAAAA"
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/songList"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="SAFAYAT MUSIC PLAYER  •  VERSION 1.0"
            android:textColor="#777777"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="35dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
